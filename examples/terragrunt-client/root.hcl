# ---------------------------------------------------------------------------
# Terragrunt root configuration (client side).
#
# Everything shared by the client units lives here:
#   - the state backend (generated dynamically, never declared in modules)
#   - the provider configuration (generated dynamically, never in modules)
#
# Each unit pins its module source to an immutable TAG (`?ref=vX.Y.Z`):
# a client project is never broken by a change on the modules' main branch.
# Bump the `?ref=` value in each unit only when you explicitly want the new
# version.
# ---------------------------------------------------------------------------
locals {
  # Node used by the bpg/proxmox provider for SSH operations (snippet uploads).
  proxmox_node_name    = get_env("PROXMOX_NODE_NAME", "pve")
  proxmox_node_address = get_env("PROXMOX_NODE_ADDRESS", "pve")
}

# ---------------------------------------------------------------------------
# State backend, generated by Terragrunt in each unit.
#
# Local backend keeps things simple for a first project. For a shared /
# CI-friendly state, replace this block with S3, HTTP, GCS, ... (see
# docs/TERRAGRUNT.md). The modules never contain a backend block.
# ---------------------------------------------------------------------------
remote_state {
  backend = "local"

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }

  config = {
    path = "${get_terragrunt_dir()}/terraform.tfstate"
  }
}

# ---------------------------------------------------------------------------
# Provider, generated by Terragrunt in each unit.
#
# Credentials are read from the environment by the bpg/proxmox provider:
#   PROXMOX_VE_ENDPOINT, PROXMOX_VE_API_TOKEN, PROXMOX_VE_INSECURE, ...
#
# SSH defaults to the SSH agent. To use a key file instead, add:
#   private_key = file(get_env("PROXMOX_VE_SSH_PRIVATE_KEY_PATH", "/workspace/id_rsa"))
# ---------------------------------------------------------------------------
generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"

  contents = <<-EOF
    provider "proxmox" {
      insecure = ${get_env("PROXMOX_VE_INSECURE", "true")}

      ssh {
        agent    = ${get_env("PROXMOX_VE_SSH_AGENT", "true")}
        username = "${get_env("PROXMOX_VE_SSH_USERNAME", "root")}"

        node {
          name    = "${local.proxmox_node_name}"
          address = "${local.proxmox_node_address}"
        }
      }
    }
  EOF
}
